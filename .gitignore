```gitignore
# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.ENV
.ENV.*
.python-version
.pytest_cache/
.mypy_cache/
.coverage
coverage/

# Build and distribution
dist/
build/
*.egg-info/
.installed.cfg
*.egg

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# IDE specific
.vscode/
.idea/
*.iml
*.ipr
*.iws
.settings/
nbproject/

# Data files that might be temporary
*.csv
*.json
*.txt
```